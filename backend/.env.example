PORT=5000
NODE_ENV=development
# On Render use DATABASE_URL instead of the DB_HOST/DB_* connection fields.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DB_SSL=true
# Use DB_SSL=false only for Render's private/internal database endpoint.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=airline_booking_demo
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_password
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://YOUR_FRONTEND.vercel.app
# Optional additional exact origins, separated by commas (HTTP + WebSocket):
# CORS_ORIGINS=https://YOUR_OTHER_FRONTEND.vercel.app
# Optional Render persistent disk mount path (paid service):
# UPLOAD_DIR=/var/data/uploads
# Configure only after checking the hosting proxy chain (hop count or CIDRs).
# TRUST_PROXY=1
DEMO_FLIGHTS_ENABLED=true
DEMO_PAYMENTS_ENABLED=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=DAMH Shop
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_REDIRECT_URL=http://localhost:5173/payment-result
MOMO_IPN_URL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
